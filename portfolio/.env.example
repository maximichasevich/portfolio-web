# Supabase: copiá este archivo como .env.local y completá los valores.
# Están en Supabase > Project Settings > API (o "Connect").
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Sal secreta para la huella anónima del límite de envíos (texto largo al azar).
# Generala con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MENSAJES_SAL=

# Solo para la CLI de Supabase en tu computadora (no va en Netlify).
SUPABASE_DB_PASSWORD=

# Direcciones públicas (opcionales; si faltan se usan las de config/sitios.ts).
# Sin barra final. Con dominio propio: NEXT_PUBLIC_SITE_URL=https://tudominio.com
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_DEMO_LA_ESPIGA_URL=
NEXT_PUBLIC_DEMO_ESTUDIO_FARO_URL=
NEXT_PUBLIC_DEMO_VERDE_TIENDA_URL=
