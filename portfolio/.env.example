# Supabase: copiá este archivo como .env.local y completá los valores.
# Están en Supabase > Project Settings > API (o "Connect").
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Direcciones públicas (opcionales; si faltan se usan las de config/sitios.ts).
